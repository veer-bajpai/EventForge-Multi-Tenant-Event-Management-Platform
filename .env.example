# Copy to .env  (cp .env.example .env). docker compose reads this file.
# Generate a real secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-too

# Local (non-docker) runs default to SQLite and an in-memory cache. Override to use Postgres/Redis:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/eventforge
# REDIS_URL=redis://localhost:6379/0

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
LOGIN_RATE_LIMIT=10
# "demo" exposes a simulated payment-confirm endpoint. Set to "live" once a real provider sends webhooks.
PAYMENT_MODE=demo
CORS_ORIGINS=*
